{
  "name": "n8n-nodes-binable",
  "version": "0.1.0",
  "description": "n8n community node for binable.app — waste collection schedules, upcoming-collection triggers (webhook + polling) and iCal feeds.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "binable",
    "waste",
    "garbage",
    "abfall",
    "muell",
    "abfuhrtermine",
    "recycling"
  ],
  "license": "MIT",
  "homepage": "https://binable.app/integration/n8n",
  "author": {
    "name": "Tim Lochmüller",
    "email": "tim@binable.app"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/binable/n8n.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "format": "prettier nodes credentials --write",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/BinableApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Binable/Binable.node.js",
      "dist/nodes/Binable/BinableTrigger.node.js",
      "dist/nodes/Binable/BinablePollingTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.46.2",
    "@types/node": "^22.10.0",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "release-it": "^19.0.4",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
